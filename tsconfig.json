{
  // Основа — корневая конфигурация Vite React + TypeScript, объединяющая проекты приложения и Node.
  // Сам корневой конфиг файлы не проверяет; это делают проекты из references.
  "files": [],
  // Проверяем оба проекта через tsc -b.
  "references": [
    {
      // Код приложения в src.
      "path": "./tsconfig.app.json"
    },
    {
      // Конфигурация Vite и скрипты из scripts/, которые выполняются в Node.
      "path": "./tsconfig.node.json"
    }
  ]
}
