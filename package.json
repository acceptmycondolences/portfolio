{
  "name": "portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "format": "prettier --write . --cache",
    "lint:fix": "eslint . --fix",
    "fix": "pnpm format && pnpm lint:fix",
    "format:check": "prettier --check . --cache",
    "lint": "eslint . --max-warnings 0",
    "routes:generate": "tsr generate",
    "types:check": "pnpm routes:generate && tsc -b",
    "arch:check": "steiger ./src",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browsers": "playwright install chromium",
    "check": "pnpm format:check && pnpm lint && pnpm types:check && pnpm arch:check && pnpm test:run",
    "dev": "vite",
    "build": "pnpm check && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "deps:update": "node scripts/update-deps/main.ts"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.3.1",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-devtools": "^1.167.2",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-rough-notation": "^1.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "typeit-react": "^2.7.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-cli": "^1.167.44",
    "@tanstack/router-plugin": "^1.168.46",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-react-dom": "^5.28.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-x": "^5.28.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "steiger": "^0.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  }
}
