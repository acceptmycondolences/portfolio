# Проверяем архитектуру FSD во всём src: нарушение может появиться и в неизменённых файлах.
pnpm arch:check

# Форматируем и проверяем только индексированные файлы по правилам lint-staged.config.js.
# --concurrent false: шаблоны выполняются по очереди, иначе tsc и Vitest могут прочитать TS-файл,
# пока Prettier из соседнего шаблона его перезаписывает (в конфиге этот параметр задать нельзя).
pnpm lint-staged --concurrent false
